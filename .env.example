# PitchEdge environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit secrets.

# --- Database (Postgres 16) ---------------------------------------------------
# SQLAlchemy URL using the psycopg (v3) driver. Must match docker-compose.yml
# (host port 5432). Makefile targets fit-dc / fit-elo / db-status override this
# with DOCKER_DB_URL so a stale port in `.env` does not break local Docker use.
DB_URL=postgresql+psycopg://pitchedge:pitchedge@localhost:5432/pitchedge

# --- Anthropic API (narrative content engine) --------------------------------
ANTHROPIC_API_KEY=

# --- Telegram Bot API (content distribution) ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public channel/group invite for the dashboard "Join" button (not used for bot posts).
# Example: https://t.me/pitchedge or https://t.me/+inviteHash
TELEGRAM_JOIN_URL=

# --- Reproducibility ----------------------------------------------------------
# Default seed for all simulations. All randomness takes an explicit seed; this
# is the project-wide default so runs are deterministic.
RANDOM_SEED=20260611

# --- Model blend weight -------------------------------------------------------
# w in p_blend = w * p_model + (1 - w) * p_market.
# PROVENANCE: Phase 4 backtest (n=208 with market odds); minimizes pooled log loss.
BLEND_W=0.00

# Published standalone model probs (content/disagreement). 1.0 = raw Dixon-Coles.
# Backtest refit was ~1.035 on n=208; we publish unscaled because scaling hurts ECE.
MODEL_TEMPERATURE=1.0

# --- Phase 4 backtest ---------------------------------------------------------
BACKTEST_ODDS_XLSX=data/backtest/WorldCup2022.xlsx
BACKTEST_REPORT_PATH=backtest_report.md
BACKTEST_RELIABILITY_PNG=reports/reliability_diagram.png
BACKTEST_EURO_COPA_CACHE=data/backtest/euro_copa_odds_cache.csv

# --- Data ingest --------------------------------------------------------------
# Kaggle: martj42/international-football-results-from-1872-to-2017 -> results.csv
HISTORY_CSV_PATH=data/kaggle/international-results/results.csv
TEAMS_CSV_PATH=data/wc2026/teams.csv
FIXTURES_CSV_PATH=data/wc2026/fixtures.csv
ANNEX_C_JSON_PATH=data/wc2026/annex_c.json

# --- Monte Carlo tournament sim (Phase 5) -------------------------------------
N_SIMS=50000

# --- the-odds-api.com (confirm sport key via GET /v4/sports) ------------------
# Historical Euro/Copa backtest odds need a paid plan (not the free tier).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_API_SPORT_KEY=soccer_fifa_world_cup
ODDS_API_REGIONS=us,uk,eu
# Results sync look-back for completed games via /scores (the-odds-api caps at 1-3).
ODDS_API_SCORES_DAYS_FROM=3

# --- Elo (fit on raw_results via make fit-elo) --------------------------------
ELO_INITIAL=1500
ELO_K=20
ELO_HOME_ADV=100
ELO_RATING_DIVISOR=400

# --- Dixon-Coles (fit via: uv run python -m pitchedge.model.dixon_coles) ------
DC_XI=0.005
DC_RECENCY_YEARS=6
DC_MIN_MATCHES=30
DC_MAX_GOALS=10
DC_RHO_MAX_ITER=100
DC_TAU_FLOOR=1e-10
