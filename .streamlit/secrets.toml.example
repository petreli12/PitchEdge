# Streamlit Community Cloud secrets template.
#
# Copy these into the Streamlit Cloud app's "Secrets" panel (Settings -> Secrets).
# NONE are required: the deployed app auto-detects the bundled data/snapshot/ and
# serves it read-only with no database. Set only what you want to enable.

# Public Telegram channel/group join link. When set, the About page renders a
# "Join on Telegram" button. Omit to hide the Telegram section entirely.
# TELEGRAM_JOIN_URL = "https://t.me/yourchannel"

# External email-capture form (Google Form / Tally / Formspree). On the public
# deploy there is no writable subscribers DB, so the landing links out to this
# form instead. Omit to hide the email form (Telegram-only).
# SUBSCRIBE_FORM_URL = "https://forms.gle/your-form"

# Override the snapshot directory (defaults to the bundled data/snapshot/).
# DASHBOARD_SNAPSHOT_DIR = "data/snapshot"

# Only set DB_URL if you intend to serve from a live, publicly-reachable Postgres
# instead of the bundled snapshot (not needed for the locked launch board).
# DB_URL = "postgresql+psycopg://user:pass@host:5432/dbname"
